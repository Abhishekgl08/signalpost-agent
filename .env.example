# SignalPost Environment Configuration Template
# Copy this file to .env and insert your API keys

# Brave Search API Key (Required for external website discovery and review snippets)
# Sign up at: https://brave.com/search/api/ (Free tier gives 2,000 queries/month)
BRAVE_API_KEY=your_brave_api_key_here

# Groq Cloud API Keys (Optional: for fast executive synthesis briefs and QA answering)
# Multiple keys can be comma-separated for automatic round-robin rotation
GROQ_KEYS=gsk_your_key_1,gsk_your_key_2
